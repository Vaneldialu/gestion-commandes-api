# ------------------------------------------------------------------
# General runtime info
# ------------------------------------------------------------------
TZ=UTC
NODE_ENV=development
HOST=localhost
PORT=3333

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
LOG_LEVEL=info
APP_KEY=zKXHe-Ahdb7aPK1ylAJlRgTefktEaACi
APP_URL=http://${HOST}:${PORT}

# ------------------------------------------------------------------
# Session storage
# ------------------------------------------------------------------
SESSION_DRIVER=cookie

# ------------------------------------------------------------------
# Database connection (override before deploying)
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gestion_commande

# ------------------------------------------------------------------
# CORS (configure allowed origins for every environment)
# ------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------
# Production checklist
# ------------------------------------------------------------------
# - switch NODE_ENV=production
# - set HOST/PORT/APP_URL to your deployed API endpoint (use https://)
# - generate a unique APP_KEY (e.g., `node ace key:generate`) and keep it secret
# - replace DB_* values with the production database credentials
# - tighten CORS_ORIGIN to the exact frontends that should access the API
